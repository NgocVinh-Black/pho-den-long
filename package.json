{
  "name": "pho-den-long",
  "version": "1.0.0",
  "private": true,
  "description": "Phố Đèn Lồng: Ba Miền Tụ Hội — game kinh doanh khu phố ẩm thực & lưu niệm Việt Nam",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run db:setup -w @pdl/api",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @pdl/api\" \"npm run dev -w @pdl/web\"",
    "build": "npm run build -w @pdl/api && npm run build -w @pdl/web",
    "test": "npm run test -w @pdl/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
