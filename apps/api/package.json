{
  "name": "@pdl/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:setup": "prisma generate && prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@pdl/shared": "*",
    "@prisma/client": "~6.19.0",
    "fastify": "^5.12.0",
    "google-auth-library": "^11.3.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "prisma": "~6.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "vitest": "^3.2.0"
  }
}
