DATABASE_URL="file:./dev.db"
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# OAuth Client ID loại "Web application" từ Google Cloud Console (để trống = chỉ chơi khách)
GOOGLE_CLIENT_ID=
# Chuỗi ngẫu nhiên ≥ 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=
# true khi chạy HTTPS
COOKIE_SECURE=false
SESSION_DAYS=30
